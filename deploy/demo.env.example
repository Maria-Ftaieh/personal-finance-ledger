# Environment for a public demo deployment. Copy to `.env` beside docker-compose.yml.
#
# Every published port is bound to loopback so the only way in is whatever TLS terminator
# you put in front. Nothing here is a secret: the database is reachable only from the
# compose network and from the host, and it holds nothing but generated data.

LEDGER_WEB_PORT=127.0.0.1:3000
LEDGER_PORT=127.0.0.1:8090
LEDGER_DB_PORT=127.0.0.1:5433

# English interface, and the fictional-data banner.
LEDGER_LOCALE=en
LEDGER_DEMO_MODE=true

# The important one. Refuses every write, and parses uploads without storing them.
LEDGER_DEMO_READ_ONLY=true
